{
  "name": "bayan",
  "version": "1.0.39",
  "private": true,
  "type": "module",
  "description": "Bayan — adaptive Arabic reading & drilling. Capacitor + React/TypeScript.",
  "scripts": {
    "assets": "capacitor-assets generate --iconBackgroundColor '#12293f' --splashBackgroundColor '#f7f7f5' --splashBackgroundColorDark '#14161a'",
    "build": "tsc -b && vite build",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "cap:sync": "npm run build && cap sync && node scripts/pin-spm-platform.mjs",
    "dev": "vite",
    "icons": "node scripts/make-icons.mjs",
    "lint": "eslint .",
    "postinstall": "patch-package",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/capacitor-llm": "^8.1.6",
    "@capgo/capacitor-updater": "^8.51.25",
    "dexie": "^4.0.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.4.0",
    "@typescript-eslint/parser": "^8.4.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^25.0.0",
    "patch-package": "^8.0.1",
    "playwright": "^1.62.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vitest": "^2.0.5"
  }
}
