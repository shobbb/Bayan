+        let config = URLSessionConfiguration.background(withIdentifier: LLMPlugin.downloadSessionIdentifier)
+        // The download is something somebody is waiting on, not housekeeping:
+        // discretionary transfers are deferred by the system until it judges
+        // the moment opportune, which for a user who just tapped Download reads
